{
  // Mypy 設定 - 針對後端 Python 專案
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.cwd": "${workspaceFolder}/backend",
  "mypy-type-checker.args": ["--config-file=mypy.ini"],
  "mypy-type-checker.reportingScope": "file",
  "mypy-type-checker.preferDaemon": true,
  "mypy-type-checker.ignorePatterns": [
    "frontend/**",
    "scripts-windows/**",
    "docs/**",
    "shared/**",
    "**/*.md",
    "**/*.json",
    "**/*.bat"
  ],

  // Python 環境設定
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Python 語言伺服器設定 - 使用 Cursor 內建 Pyright
  "python.languageServer": "None",

  // SQLTools 設定
  "sqltools.useNodeRuntime": false,

  // 編輯器格式化設定
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.formatOnPaste": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // Python 格式化設定 - 使用 Ruff
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },

  // TypeScript 錯誤抑制
  "typescript.validate.enable": true,
  "typescript.reportStyleChecksAsWarnings": false,
  "typescript.preferences.includePackageJsonAutoImports": "off",

  // 檔案設定
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n", // 強制使用 LF (Unix) 作為行結束符
  "files.associations": {
    "*.py": "python"
  },
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    // "**/.venv": true,
    "**/node_modules": true
  },
  // Cursor Pyright 設定 - 針對 Python 類型檢查和自動完成
  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.typeCheckingMode": "off",
  "cursorpyright.analysis.autoSearchPaths": true,
  "cursorpyright.analysis.diagnosticMode": "workspace"
}
