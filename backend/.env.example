# ===== BACKEND-SPECIFIC ENVIRONMENT VARIABLES =====

# ===== SHIOAJI API SETTINGS =====
# Shioaji API credentials
SHIOAJI_API_KEY=REMOVED_SHIOAJI_API_KEY
SHIOAJI_SECRET_KEY=REMOVED_SHIOAJI_SECRET_KEY
SHIOAJI_CA_PASSWD=your-ca-password

# Shioaji environment (0=simulation, 1=production)
SHIOAJI_SIMULATE=1

# ===== FASTAPI SETTINGS =====
# FastAPI server configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# API documentation
DOCS_URL=/docs
REDOC_URL=/redoc

# ===== DATABASE =====
# If using database (future expansion)
DATABASE_URL=sqlite:///./sinotrade.db

# ===== CACHE SETTINGS =====
# In-memory cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# ===== SECURITY =====
# API key authentication settings
API_KEY_HEADER=X-API-Key
ENABLE_API_KEY_AUTH=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ===== LOGGING =====
# Backend-specific logging
LOG_FILE=backend/logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===== SHIOAJI SPECIFIC =====
# WebSocket settings
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_ATTEMPTS=3

# Quote subscription limits
MAX_QUOTE_SUBSCRIPTIONS=100
QUOTE_BUFFER_SIZE=1000
