# 設定所有文件的行結束符為 LF (Unix/Linux/Mac)
* text=auto eol=lf

# 特定檔案類型的設定
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows 腳本檔案不進行行結束符轉換
*.bat -text
*.cmd -text
*.ps1 -text

# 二進制檔案
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
